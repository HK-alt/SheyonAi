# Copy this file to .env and fill in your values.
# Only EXPO_PUBLIC_* variables are bundled into the app — never put secrets here.

# Supabase project (Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Test sign-in: Google/Apple buttons use dev test accounts (email+password).
# Defaults to on in __DEV__. Set to false when real OAuth is configured.
EXPO_PUBLIC_USE_TEST_AUTH=true

# NOTE: Server-side secrets are NOT set here. They live in Supabase Edge Function secrets:
#   supabase secrets set DEEPSEEK_API_KEY=sk-...
#   supabase secrets set HF_API_TOKEN=hf_...
# Optional chat / vision model overrides:
#   supabase secrets set DEEPSEEK_MODEL=deepseek-chat
#   supabase secrets set DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# Optional NLLB model override (default: facebook/nllb-200-distilled-600M):
#   supabase secrets set NLLB_MODEL=facebook/nllb-200-distilled-600M
# See docs/INTEGRATION_GUIDE.md
